+/* 
+ * SQLite database initialization 
+ */
+void initSqliteDatabase(dsd_opts *opts) 
+{
+  int rc;
+  char *errMsg = NULL;
+  
+  // Open database connection
+  rc = sqlite3_open(opts->sqlite_db_path, &opts->db);
+  if (rc) {
+    fprintf(stderr, "Can't open SQLite database: %s\n", sqlite3_errmsg(opts->db));
+    sqlite3_close(opts->db);
+    opts->use_sqlite = 0;
+    return;
+  }
+  
+  // Create tables if they don't exist
+  char *sql_create_tables = 
+    "CREATE TABLE IF NOT EXISTS dmr_sessions ("
+    "  session_id INTEGER PRIMARY KEY AUTOINCREMENT,"
+    "  start_time DATETIME DEFAULT CURRENT_TIMESTAMP,"
+    "  src_id INTEGER,"
+    "  tgt_id INTEGER"
+    ");"
+    
+    "CREATE TABLE IF NOT EXISTS pi_headers ("
+    "  header_id INTEGER PRIMARY KEY AUTOINCREMENT,"
+    "  session_id INTEGER,"
+    "  timestamp DATETIME DEFAULT CURRENT_TIMESTAMP,"
+    "  slot INTEGER,"
+    "  iv_data BLOB,"
+    "  raw_data BLOB,"
+    "  FOREIGN KEY(session_id) REFERENCES dmr_sessions(session_id)"
+    ");"
+    
+    "CREATE TABLE IF NOT EXISTS cont_headers ("
+    "  header_id INTEGER PRIMARY KEY AUTOINCREMENT,"
+    "  session_id INTEGER,"
+    "  timestamp DATETIME DEFAULT CURRENT_TIMESTAMP,"
+    "  slot INTEGER,"
+    "  header_data BLOB,"
+    "  raw_data BLOB,"
+    "  FOREIGN KEY(session_id) REFERENCES dmr_sessions(session_id)"
+    ");"
+    
+    "CREATE TABLE IF NOT EXISTS ambe_frames ("
+    "  frame_id INTEGER PRIMARY KEY AUTOINCREMENT,"
+    "  session_id INTEGER,"
+    "  timestamp DATETIME DEFAULT CURRENT_TIMESTAMP,"
+    "  slot INTEGER,"
+    "  frame_number INTEGER,"
+    "  ambe_data BLOB,"
+    "  FOREIGN KEY(session_id) REFERENCES dmr_sessions(session_id)"
+    ");";
+  
+  rc = sqlite3_exec(opts->db, sql_create_tables, NULL, 0, &errMsg);
+  if (rc != SQLITE_OK) {
+    fprintf(stderr, "SQL error: %s\n", errMsg);
+    sqlite3_free(errMsg);
+    sqlite3_close(opts->db);
+    opts->use_sqlite = 0;
+  }
+}
+
+void prepareSqliteStatements(dsd_opts *opts)
+{
+  // Prepare statements for later use
+  sqlite3_prepare_v2(opts->db, 
+                    "INSERT INTO pi_headers (session_id, slot, iv_data, raw_data) VALUES (?, ?, ?, ?)",
+                    -1, &opts->insert_pi_header_stmt, NULL);
+                    
+  sqlite3_prepare_v2(opts->db,
+                    "INSERT INTO cont_headers (session_id, slot, header_data, raw_data) VALUES (?, ?, ?, ?)",
+                    -1, &opts->insert_cont_header_stmt, NULL);
+                    
+  sqlite3_prepare_v2(opts->db,
+                    "INSERT INTO ambe_frames (session_id, slot, frame_number, ambe_data) VALUES (?, ?, ?, ?)",
+                    -1, &opts->insert_ambe_frame_stmt, NULL);
+}
