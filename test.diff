+/* 
+ * SQLite logging functions
+ */
+void logPiHeader(dsd_opts *opts, int slot, unsigned char *iv_data, unsigned char *raw_data, int data_len)
+{
+  if (!opts->use_sqlite)
+    return;
+    
+  // Start a new session if needed
+  if (opts->current_session_id <= 0) {
+    char *errMsg = NULL;
+    char sql[100];
+    sqlite3_stmt *stmt;
+    
+    // Insert new session
+    sqlite3_prepare_v2(opts->db, 
+                      "INSERT INTO dmr_sessions (src_id, tgt_id) VALUES (?, ?)",
+                      -1, &stmt, NULL);
+                      
+    sqlite3_bind_int(stmt, 1, opts->src_id);
+    sqlite3_bind_int(stmt, 2, opts->tg_id);
+    
+    if (sqlite3_step(stmt) != SQLITE_DONE) {
+      fprintf(stderr, "SQL error creating session: %s\n", sqlite3_errmsg(opts->db));
+    } else {
+      opts->current_session_id = sqlite3_last_insert_rowid(opts->db);
+    }
+    
+    sqlite3_finalize(stmt);
+  }
+  
+  // Log the PI header with IV data
+  sqlite3_bind_int(opts->insert_pi_header_stmt, 1, opts->current_session_id);
+  sqlite3_bind_int(opts->insert_pi_header_stmt, 2, slot);
+  sqlite3_bind_blob(opts->insert_pi_header_stmt, 3, iv_data, 4, SQLITE_STATIC);
+  sqlite3_bind_blob(opts->insert_pi_header_stmt, 4, raw_data, data_len, SQLITE_STATIC);
+  
+  if (sqlite3_step(opts->insert_pi_header_stmt) != SQLITE_DONE) {
+    fprintf(stderr, "SQL error inserting PI header: %s\n", sqlite3_errmsg(opts->db));
+  }
+  
+  sqlite3_reset(opts->insert_pi_header_stmt);
+}
+
+void logContHeader(dsd_opts *opts, int slot, unsigned char *header_data, unsigned char *raw_data, int data_len)
+{
+  if (!opts->use_sqlite || opts->current_session_id <= 0)
+    return;
+    
+  sqlite3_bind_int(opts->insert_cont_header_stmt, 1, opts->current_session_id);
+  sqlite3_bind_int(opts->insert_cont_header_stmt, 2, slot);
+  sqlite3_bind_blob(opts->insert_cont_header_stmt, 3, header_data, 4, SQLITE_STATIC);
+  sqlite3_bind_blob(opts->insert_cont_header_stmt, 4, raw_data, data_len, SQLITE_STATIC);
+  
+  if (sqlite3_step(opts->insert_cont_header_stmt) != SQLITE_DONE) {
+    fprintf(stderr, "SQL error inserting continuation header: %s\n", sqlite3_errmsg(opts->db));
+  }
+  
+  sqlite3_reset(opts->insert_cont_header_stmt);
+}
+
+void logAmbeFrame(dsd_opts *opts, int slot, int frame_number, unsigned char *ambe_data, int data_len)
+{
+  if (!opts->use_sqlite || opts->current_session_id <= 0)
+    return;
+    
+  sqlite3_bind_int(opts->insert_ambe_frame_stmt, 1, opts->current_session_id);
+  sqlite3_bind_int(opts->insert_ambe_frame_stmt, 2, slot);
+  sqlite3_bind_int(opts->insert_ambe_frame_stmt, 3, frame_number);
+  sqlite3_bind_blob(opts->insert_ambe_frame_stmt, 4, ambe_data, data_len, SQLITE_STATIC);
+  
+  if (sqlite3_step(opts->insert_ambe_frame_stmt) != SQLITE_DONE) {
+    fprintf(stderr, "SQL error inserting AMBE frame: %s\n", sqlite3_errmsg(opts->db));
+  }
+  
+  sqlite3_reset(opts->insert_ambe_frame_stmt);
+}
